{
  "name": "llm-charts",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "LLM 性价比图鉴：以「每任务成本 × AA 智能指数」双轴可视化 Artificial Analysis LLM Leaderboard",
  "license": "MIT",
  "author": "NoroHime",
  "homepage": "https://NoroHime.github.io/LLM_Charts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoroHime/LLM_Charts.git"
  },
  "bugs": {
    "url": "https://github.com/NoroHime/LLM_Charts/issues"
  },
  "keywords": [
    "llm",
    "leaderboard",
    "artificial-analysis",
    "echarts",
    "visualization",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
